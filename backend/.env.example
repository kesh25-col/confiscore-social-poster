# Confiscore Social Poster — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Required ─────────────────────────────────────────────────────────────────
# Claude API key — powers content + poster generation.
ANTHROPIC_API_KEY=

# ── Recommended ──────────────────────────────────────────────────────────────
# Serper.dev key — web research for supporting post context. App runs without it.
SERPER_API_KEY=

# ── LinkedIn (needed to connect a LinkedIn account via OAuth) ─────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn versioned API month. Default is 202606 if unset.
LINKEDIN_API_VERSION=202606

# ── Facebook (optional; currently has a known app-key mismatch) ───────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Instagram (optional; posting currently not working) ───────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# imgbb key — Instagram needs a public image URL to post; imgbb hosts it.
IMGBB_API_KEY=

# ── Access gate (optional) ────────────────────────────────────────────────────
# Set to require a shared password for hosted/shared deployments.
# Leave empty for open local development.
APP_PASSWORD=

# ── Deployment overrides (optional) ───────────────────────────────────────────
# Usually auto-detected. Set explicitly when self-hosting.
# BACKEND_URL=http://localhost:8000
# FRONTEND_URL=http://localhost:5173
# DATA_DIR=
