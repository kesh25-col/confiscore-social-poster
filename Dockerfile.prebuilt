# Lightweight image for a small (free-tier) server.
# Uses the pre-built frontend in frontend/dist (committed on the deploy-aws branch),
# so there's NO Node build step — fast and light enough for a t2.micro/t3.micro.
FROM python:3.11-slim
WORKDIR /app

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY backend/ ./backend/
COPY frontend/dist ./frontend/dist

WORKDIR /app/backend
ENV PORT=8000
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
